# Rust gateway
GATEWAY_BIND=0.0.0.0:8080
GATEWAY_DB_PATH=/var/lib/cypht-gateway/gateway.db
# Compose host binding. 18080 is a candidate and must be checked on the host.
GATEWAY_HOST_PORT=18080
GATEWAY_DOCKER_NETWORK=cypht-gateway
GATEWAY_PUBLIC_HOST=127.0.0.1
GATEWAY_PUBLIC_ORIGIN=http://127.0.0.1:8088
# Compose binds REST to loopback unless this is set. For Unraid LAN use 192.168.8.11.
# GATEWAY_HOST_IP=192.168.8.11
GATEWAY_SESSION_TTL_SECONDS=3600
GATEWAY_MASTER_KEY=
RUST_LOG=gatewayd=info,tower_http=info

# Cypht connection. These two secrets must match Cypht's environment.
# Cypht native UI remains at http://192.168.8.11:8088/.
# Gateway should use the private container-to-container URL when they share a Docker network.
CYPHT_BASE_URL=http://cypht/
CYPHT_API_LOGIN_KEY=
CYPHT_BRIDGE_KEY=

# Cypht side (shown here for deployment coordination)
# API_LOGIN_KEY=<same value as CYPHT_API_LOGIN_KEY>
# GATEWAY_BRIDGE_KEY=<same value as CYPHT_BRIDGE_KEY>
# CYPHT_MODULES=<existing modules>,api_login,gateway

# Cypht bridge upload limit (default 20 MiB)
# GATEWAY_MAX_UPLOAD_BYTES=20971520
# GATEWAY_MAX_ATTACHMENT_BYTES=26214400

# MCP sidecar (optional)
# CYPHT_GATEWAY_URL=http://gateway:8080
# CYPHT_GATEWAY_TOKEN=cypht_pat_...   # stdio only; HTTP callers should send their own bearer PAT
# CYPHT_MCP_BIND=127.0.0.1:8790
# CYPHT_MCP_ALLOW_WRITE=false

# Optional edge proxy. On Unraid, move Cypht off 8088 before binding this port.
GATEWAY_EDGE_HOST_IP=127.0.0.1
GATEWAY_EDGE_HOST_PORT=8088
