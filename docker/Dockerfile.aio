ARG CYPHT_IMAGE=cypht/cypht:2.12.0
FROM rust:1.88-bookworm AS builder
WORKDIR /src
COPY . .
ARG BUILD_TIME=unknown
ENV BUILD_TIME=${BUILD_TIME}
RUN cargo build --release -p gatewayd -p cyphtctl -p cypht-mcp

FROM ${CYPHT_IMAGE}

# Copy Rust binaries
COPY --from=builder /src/target/release/gatewayd /usr/local/bin/gatewayd
COPY --from=builder /src/target/release/cyphtctl /usr/local/bin/cyphtctl
COPY --from=builder /src/target/release/cypht-mcp /usr/local/bin/cypht-mcp

# Copy Cypht gateway module, unified Nginx routing, and configuration
COPY modules/gateway /usr/local/share/cypht/modules/gateway
COPY docker/nginx-aio.conf /etc/nginx/nginx.conf
COPY docker/cypht-gateway-config.php /usr/local/share/cypht/config/gateway.php
COPY docker/cypht-gateway-entrypoint.sh /usr/local/bin/cypht-gateway-entrypoint.sh
COPY docker/all-in-one-entrypoint.sh /usr/local/bin/all-in-one-entrypoint.sh
COPY docker/supervisord-aio.conf /etc/supervisor/conf.d/supervisord-gateway.conf

RUN chmod 0755 /usr/local/bin/all-in-one-entrypoint.sh \
               /usr/local/bin/cypht-gateway-entrypoint.sh \
               /usr/local/bin/gatewayd \
               /usr/local/bin/cyphtctl \
               /usr/local/bin/cypht-mcp \
    && mkdir -p /var/lib/hm3/app_data/gateway /etc/supervisor/conf.d \
    && printf 'auto_prepend_file=/usr/local/share/cypht/modules/gateway/bootstrap.php\n' \
       > /usr/local/etc/php/conf.d/cypht-gateway.ini

ENV USER_CONFIG_TYPE=custom:Gateway_User_Config_File \
    CYPHT_MODULES=core,contacts,local_contacts,feeds,imap,smtp,account,idle_timer,calendar,themes,nux,developer,history,saved_searches,advanced_search,highlights,profiles,inline_message,imap_folders,keyboard_shortcuts,tags,brute_force,sievefilters,api_login,gateway \
    GATEWAY_BIND=0.0.0.0:18080 \
    GATEWAY_DATA_DIR=/var/lib/hm3/app_data/gateway \
    GATEWAY_DB_PATH=/var/lib/hm3/app_data/gateway/gateway.db \
    CYPHT_BASE_URL=http://127.0.0.1:8089/

VOLUME ["/var/lib/hm3/users", "/var/lib/hm3/attachments", "/var/lib/hm3/app_data"]
EXPOSE 80 18080 8790

ENTRYPOINT ["/usr/local/bin/all-in-one-entrypoint.sh"]