# Local Gateway container connecting to the existing Unraid Cypht service.
# This is the Cypht upstream URL, not the Gateway REST listen address.
CYPHT_BASE_URL=http://192.168.8.11:8088/

# The current computer serves Gateway REST on this local-only candidate port.
# Verify that port 18080 is free before starting Compose.
GATEWAY_HOST_IP=127.0.0.1
GATEWAY_HOST_PORT=18080
GATEWAY_DOCKER_NETWORK=cypht-gateway
GATEWAY_PUBLIC_HOST=127.0.0.1
GATEWAY_PUBLIC_ORIGIN=http://127.0.0.1:8088
GATEWAY_EDGE_HOST_IP=127.0.0.1
GATEWAY_EDGE_HOST_PORT=8088
GATEWAY_MASTER_KEY=
CYPHT_API_LOGIN_KEY=
CYPHT_BRIDGE_KEY=
RUST_LOG=gatewayd=info,tower_http=info
