# Gateway uses a separate host port. Cypht keeps host port 8088.
GATEWAY_EDGE_HOST_IP=192.168.8.11
GATEWAY_EDGE_HOST_PORT=18081
GATEWAY_PUBLIC_HOST=192.168.8.11
GATEWAY_PUBLIC_ORIGIN=http://192.168.8.11:18081
GATEWAY_DOCKER_NETWORK=cypht-gateway

# Keep REST direct access on host loopback. Verify host port 18080 is free.
GATEWAY_HOST_IP=127.0.0.1
GATEWAY_HOST_PORT=18080

# Cypht modules are set in the custom Cypht image and its Unraid template.
# This file configures Gateway Compose services only.

# The Cypht container also needs API_LOGIN_KEY set in its own Unraid template. Do not put that secret in this file.
# The Gateway container must reach Cypht on the shared private Docker network.
CYPHT_BASE_URL=http://cypht:80/

# Set unique secret values outside Git before starting Compose.
GATEWAY_MASTER_KEY=
CYPHT_API_LOGIN_KEY=
CYPHT_BRIDGE_KEY=
